# InsightFace buffalo_l 가중치의 비상업 연구 조건을 직접 확인한 뒤 true로 변경한다.
FACEGUARD_ACCEPT_NONCOMMERCIAL_MODEL_LICENSE=false

# auto는 CUDA가 있으면 CUDA, 없으면 CPU를 사용한다.
FACEGUARD_DEVICE=auto
FACEGUARD_MODEL_NAME=buffalo_l
FACEGUARD_MODEL_ROOT=.models/insightface

# 현재 값은 Celeb-real 연구 기준선이며 운영 확정값이 아니다.
FACEGUARD_SIMILARITY_THRESHOLD=0.2823836207389832
FACEGUARD_THRESHOLD_STATUS=research_only_unapproved

FACEGUARD_MAX_IMAGE_BYTES=8388608
FACEGUARD_MAX_IMAGE_PIXELS=20000000
FACEGUARD_MIN_DETECTION_SCORE=0.60
FACEGUARD_MIN_FACE_AREA_RATIO=0.01
