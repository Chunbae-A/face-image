# InsightFace buffalo_l 가중치의 비상업 연구 조건을 직접 확인한 뒤 true로 변경한다.
FACEGUARD_ACCEPT_NONCOMMERCIAL_MODEL_LICENSE=false

# auto는 CUDA가 있으면 CUDA, 없으면 CPU를 사용한다.
FACEGUARD_DEVICE=auto
FACEGUARD_MODEL_NAME=buffalo_l
FACEGUARD_MODEL_ROOT=.models/insightface

# 현재 값은 Celeb-real 연구 기준선이며 운영 확정값이 아니다.
FACEGUARD_SIMILARITY_THRESHOLD=0.2823836207389832
# 공개 웹 validation 전의 임시 넓은 후보수집 기준값이다.
FACEGUARD_RETRIEVAL_SIMILARITY_THRESHOLD=0.20
FACEGUARD_THRESHOLD_STATUS=research_only_unapproved

FACEGUARD_MAX_IMAGE_BYTES=8388608
FACEGUARD_MAX_IMAGE_PIXELS=20000000
# 영상 API는 메모리·동기 요청 보호를 위해 50MB·120초로 제한한다.
FACEGUARD_MAX_VIDEO_BYTES=52428800
FACEGUARD_MAX_VIDEO_SECONDS=120
# 영상 50MB + 등록 사진 5×8MB + multipart 여유 1MB의 전체 요청 제한이다.
FACEGUARD_MAX_VIDEO_REQUEST_BYTES=95420416
FACEGUARD_MIN_DETECTION_SCORE=0.60
FACEGUARD_MIN_FACE_AREA_RATIO=0.01

# 무료 공개 URL 후보 정규화 단계의 요청·제공자 제한값이다.
FACEGUARD_MAX_SEARCH_CANDIDATES=100
FACEGUARD_SEARCH_PROVIDER_TIMEOUT_SECONDS=12.0
FACEGUARD_MAXIMUM_PIPELINE_CANDIDATES=10
FACEGUARD_CANDIDATE_DOWNLOAD_TIMEOUT_SECONDS=4.0
FACEGUARD_CANDIDATE_DOWNLOAD_MAXIMUM_REDIRECTS=2

# 비동기 데모는 등록 임베딩과 스캔 결과를 프로세스 메모리에만 임시 보관한다.
FACEGUARD_EXPOSURE_ENROLLMENT_TTL_SECONDS=1800
FACEGUARD_EXPOSURE_SCAN_TTL_SECONDS=3600
FACEGUARD_MAXIMUM_EXPOSURE_ENROLLMENTS=100
FACEGUARD_MAXIMUM_EXPOSURE_SCANS=100

# 비공개 EfficientNet-B4 ONNX는 GitHub가 아니라 이 로컬 디렉터리에 둔다.
FACEGUARD_DEEPFAKE_MODEL_HOST_DIR=.models/deepfake
FACEGUARD_DEEPFAKE_MODEL_PATH=.models/deepfake/efficientnet_b4.onnx
FACEGUARD_DEEPFAKE_CALIBRATION_PATH=.models/deepfake/deepfake_video_calibration.json
FACEGUARD_DEEPFAKE_MODEL_SHA256=c32a8532e2e1bd275b833b16460946eb307207098e0c07e2247851b71c23a6f1
FACEGUARD_DEEPFAKE_DEVICE=cpu
# 영상 16프레임 평균에서 고른 연구 기준값으로, 단일 이미지 운영값이 아니다.
FACEGUARD_DEEPFAKE_THRESHOLD=0.7519882693886758
FACEGUARD_DEEPFAKE_THRESHOLD_STATUS=research_only_single_image_unvalidated
# 영상은 학습·검증과 같은 16프레임 평균을 사용하되 운영 Gate는 미통과 상태다.
FACEGUARD_DEEPFAKE_VIDEO_FRAME_COUNT=16
FACEGUARD_DEEPFAKE_VIDEO_MINIMUM_VALID_FRAMES=4
FACEGUARD_DEEPFAKE_VIDEO_THRESHOLD_STATUS=research_only_unapproved

# SearXNG 결합 Compose에서 사용하는 무료 키워드 검색 설정이다.
SEARXNG_IMAGE=ghcr.io/searxng/searxng:2026.5.10-df1f24fb7
SEARXNG_SECRET=replace-with-a-random-local-secret
FACEGUARD_SEARXNG_REQUEST_TIMEOUT_SECONDS=4.0
FACEGUARD_SEARXNG_MAXIMUM_RETRIES=1
FACEGUARD_SEARXNG_RETRY_BACKOFF_SECONDS=0.25
