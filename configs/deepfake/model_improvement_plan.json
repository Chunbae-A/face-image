{
  "schema_version": 1,
  "project": "deepsogak_deepfake_model_improvement",
  "purpose": "실제 웹 후보 영상에서 딥페이크 위험을 더 안정적으로 선별하기 위한 비교 실험",
  "baseline": {
    "candidate_id": "p0_efficientnet_b4",
    "architecture": "EfficientNet-B4",
    "report": "reports/celebdf_deepfake_baseline/2026-08-07/README.md",
    "official_test": {
      "video_roc_auc": 0.999802,
      "real_video_fpr": 0.016854,
      "fake_video_recall": 1.0,
      "coverage": 0.998069
    },
    "known_weaknesses": {
      "downscale_0_25_real_fpr": 0.1292,
      "gaussian_blur_real_fpr": 0.118,
      "low_light_fake_recall": 0.7824
    }
  },
  "data_sources": [
    {
      "id": "celeb_df_v2",
      "role": "고정 기준선과 잠금 최종 시험",
      "access": "승인 및 보유 완료",
      "license_gate": "승인받은 연구 범위만 사용",
      "raw_data_in_git": false
    },
    {
      "id": "dfdc_preview",
      "role": "서로 다른 촬영 환경의 외부 검증과 실제 영상 hard negative 후보",
      "access": "별도 약관 확인 후 확보",
      "license_gate": "Meta 데이터 이용 조건 확인 전 실행 금지",
      "raw_data_in_git": false
    },
    {
      "id": "faceforensics_plus_plus",
      "role": "다른 조작 방식에 대한 교차 데이터셋 검증",
      "access": "공식 신청 필요",
      "license_gate": "승인 전 다운로드 및 학습 금지",
      "raw_data_in_git": false
    },
    {
      "id": "deeperforensics_subset",
      "role": "압축·흐림·저조도 등 촬영 열화 검증",
      "access": "비상업 연구 조건 확인 후 소규모 subset",
      "license_gate": "공식 이용 조건 확인 전 실행 금지",
      "raw_data_in_git": false
    },
    {
      "id": "df40_subset",
      "role": "최신·다양한 조작 방식의 잠금 외부 시험",
      "access": "비상업 연구 조건 확인 후 소규모 subset",
      "license_gate": "CC BY-NC 4.0 및 원천 데이터 조건 확인 전 실행 금지",
      "raw_data_in_git": false
    }
  ],
  "protocol": {
    "fixed_split_manifest": "private://manifests/deepfake_improvement_split_v1.csv",
    "split_unit": "source_video_and_identity_group",
    "split_before_frame_extraction": true,
    "same_manifest_for_every_candidate": true,
    "official_test_locked_until_candidate_frozen": true,
    "official_test_used_for_training": false,
    "official_test_used_for_threshold_selection": false,
    "hard_negative_source": "validation_false_positives_only",
    "test_errors_recycled_into_training": false,
    "video_level_sampling": true,
    "maximum_train_frames_per_video": 16,
    "exploration_seeds": [20260808],
    "finalist_seeds": [20260808, 20260809, 20260810]
  },
  "common_evaluation": {
    "decision_unit": "video",
    "frame_counts": [8, 16],
    "aggregation": "mean",
    "threshold_selected_on": "validation",
    "threshold_target_validation_fpr": 0.01,
    "mandatory_metrics": [
      "video_roc_auc",
      "average_precision",
      "real_video_fpr",
      "fake_video_recall",
      "false_negative_rate",
      "coverage",
      "ece",
      "latency_p50_ms",
      "latency_p95_ms"
    ],
    "robustness_conditions": [
      "clean",
      "jpeg_q30",
      "gaussian_blur_sigma2",
      "low_light_gamma2",
      "downscale_0_25"
    ],
    "cross_dataset_reporting_required": true
  },
  "gates": {
    "clean_real_video_fpr_maximum": 0.01,
    "clean_fake_video_recall_minimum": 0.95,
    "clean_coverage_minimum": 0.99,
    "low_light_fake_recall_research_target": 0.85,
    "robustness_conditions_improved_vs_baseline_minimum": 3,
    "train_validation_video_overlap": 0,
    "train_validation_group_overlap": 0,
    "operating_threshold_frozen_before_official_test": true
  },
  "stages": [
    {
      "id": "p0_efficientnet_b4",
      "name": "현재 기준선 재현",
      "kind": "frame_model",
      "depends_on": [],
      "trainable": true,
      "goal": "기존 수치와 데이터 분할을 재현해 비교 출발점을 고정"
    },
    {
      "id": "p1_xception",
      "name": "Xception 공정 비교",
      "kind": "frame_model",
      "depends_on": ["p0_efficientnet_b4"],
      "trainable": true,
      "goal": "데이터와 평가 규칙은 그대로 두고 모델 구조만 바꿔 효과 측정"
    },
    {
      "id": "p2_sbi",
      "name": "SBI 일반화 실험",
      "kind": "frame_model",
      "depends_on": ["p0_efficientnet_b4"],
      "trainable": true,
      "goal": "특정 딥페이크 방식 암기 대신 조작 흔적 일반화 개선"
    },
    {
      "id": "p3_hard_negative",
      "name": "실제 영상 오경고 집중 보강",
      "kind": "data_improvement",
      "depends_on": ["p1_xception", "p2_sbi"],
      "trainable": true,
      "goal": "validation에서 가짜로 오인한 실제 영상과 촬영 열화를 학습에 보강"
    },
    {
      "id": "p4_ftcn",
      "name": "FTCN 시간 일관성 실험",
      "kind": "video_model",
      "depends_on": ["p3_hard_negative"],
      "trainable": true,
      "goal": "한 장의 흔적뿐 아니라 프레임 사이 움직임 불일치까지 사용"
    },
    {
      "id": "p5_ensemble",
      "name": "검증 통과 모델만 앙상블",
      "kind": "ensemble",
      "depends_on": ["p3_hard_negative", "p4_ftcn"],
      "trainable": false,
      "goal": "서로 다른 오류를 내는 모델 조합이 단일 모델보다 나은지 확인"
    }
  ],
  "selection": {
    "rank_on": "validation",
    "primary_metric": "real_video_fpr_at_fake_video_recall_0_95",
    "tie_breakers": [
      "cross_dataset_video_roc_auc",
      "robustness_macro_video_roc_auc",
      "latency_p95_ms"
    ],
    "one_exploration_seed_for_all_candidates": true,
    "three_seed_confirmation_for_finalists_only": true,
    "ensemble_allowed_only_if_validation_gate_passes": true
  },
  "compute_budget": {
    "preferred_environment": "Kaggle T4 GPU",
    "first_pass_candidates": ["p0_efficientnet_b4", "p1_xception", "p2_sbi"],
    "mixed_precision": true,
    "resume_from_private_checkpoint": true,
    "private_preprocessed_cache": true,
    "raw_media_uploaded_to_github": false
  },
  "artifacts": {
    "private": [
      "raw_video",
      "face_crop",
      "per_video_score",
      "checkpoint",
      "onnx_model",
      "split_manifest_with_identifiers"
    ],
    "committable": [
      "aggregate_metrics",
      "aggregate_confusion_matrix",
      "roc_and_pr_curves",
      "deidentified_failure_summary",
      "model_card",
      "environment_lock"
    ]
  }
}
